{
  "name": "Receiving Log",
  "title": "Receiving Log 001",
  "code": "Log 001",
  "category": "Receiving",
  "frequency": "Each delivery",
  "layout": "sheet",
  "description": "By accepting the truck, the receiver has inspected the truck container for pest harborage, odors, toxic materials and all signs of physical damage, as stated in the Receiving, Shipping and Product Release Program SOP 045.",
  "footnotes": [
    "* By accepting the truck, the receiver inspected the truck container for pest harborage, odors, toxic materials, and all signs of physical damage as stated in the Receiving, Shipping, and Product Release Program SOP 045.",
    "Corrective Action: If product is out of temperature range, or other receiving policies are not adhered to, report findings to Management IMMEDIATELY. Determine duration of nonconformance and initiate a corrective action.",
    "Temperature Parameter: Refrigerated Anaerobic Product Surface < +38°F; All Other Refrigerated Product Surface < 40°F; Frozen Product Surface < +10°F; Dry - no damage."
  ],
  "docInfo": "Revision: 10 · Date: 01/31/2023 · Document Number: Log 001",
  "sections": [
    {
      "title": "Received items",
      "fields": [
        {
          "id": "items",
          "label": "Items received",
          "type": "table",
          "rows": 12,
          "columns": [
            { "id": "date", "label": "Date", "type": "date", "span": 2, "w": 9.5 },
            { "id": "vendor", "label": "Vendor", "type": "text", "span": 2, "w": 12 },
            { "id": "item", "label": "Item", "type": "text", "span": 2, "w": 13 },
            { "id": "po", "label": "PO# or BOL#", "type": "text", "w": 8.5 },
            { "id": "lot", "label": "Lot code", "type": "text", "w": 7.5 },
            { "id": "exp", "label": "Exp. date", "type": "text", "w": 6.5 },
            { "id": "amount", "label": "Amount", "type": "number", "w": 5.5 },
            { "id": "unit", "label": "Unit", "type": "select", "options": ["cs", "ea", "lb", "bag", "pallet"], "w": 5 },
            { "id": "truckTemp", "label": "Truck", "type": "number", "unit": "°F", "w": 5 },
            { "id": "productTemp", "label": "Product", "type": "number", "unit": "°F", "w": 5 },
            { "id": "spec", "label": "Product spec", "type": "checkbox", "w": 5 },
            { "id": "accepted", "label": "Accepted* / Rejected", "type": "passfail", "options": ["Accepted", "Rejected"], "w": 6.5 },
            { "id": "storage", "label": "Storage", "type": "select", "options": ["dry", "cooler", "frozen"], "w": 6.5 },
            { "id": "seal", "label": "If FTL, seal #(s)", "type": "text", "w": 8 },
            { "id": "ltl", "label": "If LTL, locked/ secured", "type": "checkbox", "w": 5 },
            { "id": "init", "label": "Init", "type": "text", "w": 4.5 }
          ]
        }
      ]
    },
    {
      "title": "QA verification",
      "fields": [
        { "id": "verifiedBy", "label": "Verification by QA", "type": "text" },
        { "id": "verifiedDate", "label": "Date", "type": "date" }
      ]
    }
  ]
}
